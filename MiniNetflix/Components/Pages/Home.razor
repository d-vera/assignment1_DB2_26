@page "/"

<PageTitle>MiniNetflix - Movie Streaming Catalog</PageTitle>

<div class="text-center mt-4">
    <h1>🎬 MiniNetflix</h1>
    <p class="lead">Movie Streaming Catalog — Database II Assignment</p>
    <hr />
</div>

<div class="row mt-4">
    <div class="col-md-4">
        <div class="card text-center">
            <div class="card-body">
                <h5 class="card-title">🎬 Movies</h5>
                <p class="card-text">Browse, add, edit, and manage movies in the catalog.</p>
                <a href="/movies" class="btn btn-primary">Go to Movies</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center">
            <div class="card-body">
                <h5 class="card-title">🎭 Actors</h5>
                <p class="card-text">Manage the actors database with full CRUD operations.</p>
                <a href="/actors" class="btn btn-primary">Go to Actors</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center">
            <div class="card-body">
                <h5 class="card-title">🎬 Directors</h5>
                <p class="card-text">Manage the directors database with filtering and search.</p>
                <a href="/directors" class="btn btn-primary">Go to Directors</a>
            </div>
        </div>
    </div>
</div>
