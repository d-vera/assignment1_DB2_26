@page "/movies/create"
@page "/movies/edit/{Id}"
@using MiniNetflix.Models
@using MiniNetflix.Services
@inject MovieService MovieService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>@(isEdit ? "Edit Movie" : "Create Movie") - MiniNetflix</PageTitle>

<h1>@(isEdit ? "✏️ Edit Movie" : "🎬 Create Movie")</h1>

<div class="row">
    <div class="col-md-8">
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <EditForm Model="movie" OnValidSubmit="HandleSubmit" FormName="movieForm">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" />

            <div class="mb-3">
                <label class="form-label">Title</label>
                <InputText class="form-control" @bind-Value="movie.Title" />
                <ValidationMessage For="() => movie.Title" />
            </div>

            <div class="mb-3">
                <label class="form-label">Genre</label>
                <InputSelect class="form-select" @bind-Value="movie.Genre">
                    <option value="">-- Select Genre --</option>
                    @foreach (var genre in genres)
                    {
                        <option value="@genre">@genre</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => movie.Genre" />
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label">Release Year</label>
                    <InputNumber class="form-control" @bind-Value="movie.ReleaseYear" />
                    <ValidationMessage For="() => movie.ReleaseYear" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Duration (minutes)</label>
                    <InputNumber class="form-control" @bind-Value="movie.DurationMinutes" />
                    <ValidationMessage For="() => movie.DurationMinutes" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Rating (0-10)</label>
                    <InputNumber class="form-control" @bind-Value="movie.Rating" />
                    <ValidationMessage For="() => movie.Rating" />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Language</label>
                <InputText class="form-control" @bind-Value="movie.Language" />
                <ValidationMessage For="() => movie.Language" />
            </div>

            <div class="mb-3">
                <label class="form-label">Synopsis</label>
                <InputTextArea class="form-control" rows="4" @bind-Value="movie.Synopsis" />
                <ValidationMessage For="() => movie.Synopsis" />
            </div>

            <div class="mb-3">
                <button type="submit" class="btn btn-success">@(isEdit ? "Update" : "Create")</button>
                <a href="/movies" class="btn btn-secondary ms-2">Cancel</a>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [Parameter]
    public string? Id { get; set; }

    private Movie movie = new();
    private bool isEdit => !string.IsNullOrEmpty(Id);
    private string? errorMessage;

    private readonly List<string> genres = new()
    {
        "Action", "Adventure", "Animation", "Comedy", "Crime", "Documentary",
        "Drama", "Fantasy", "Horror", "Musical", "Mystery", "Romance",
        "Sci-Fi", "Thriller", "War", "Western"
    };

    protected override async Task OnInitializedAsync()
    {
        if (isEdit && Id != null)
        {
            var existing = await MovieService.GetByIdAsync(Id);
            if (existing != null)
                movie = existing;
            else
                Navigation.NavigateTo("/movies");
        }
    }

    private async Task HandleSubmit()
    {
        try
        {
            errorMessage = null;
            if (isEdit && Id != null)
                await MovieService.UpdateAsync(Id, movie);
            else
                await MovieService.CreateAsync(movie);

            Navigation.NavigateTo("/movies");
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to save movie: {ex.Message}";
        }
    }
}
